// ============================================================
// AURA LUXURY — Prisma Schema
// Sección 59 del master spec: tablas principales
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// AUTENTICACIÓN (Auth.js)
// ------------------------------------------------------------

enum Role {
  CLIENT
  ADMIN
}

enum EmailStatus {
  UNVERIFIED
  VERIFIED
}

enum DiscountStatus {
  AVAILABLE
  RESERVED
  USED
}

model User {
  id                    String         @id @default(uuid())
  name                  String
  username              String         @unique
  email                 String         @unique
  passwordHash          String?
  role                  Role           @default(CLIENT)
  emailStatus           EmailStatus    @default(UNVERIFIED)
  firstPurchaseDiscount DiscountStatus @default(AVAILABLE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  reviews  Review[]
  auditLogs AuditLog[]

  @@map("users")
}

// Modelos requeridos por Auth.js (adapter Prisma)
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------------
// CATÁLOGO
// ------------------------------------------------------------

enum Gender {
  HOMBRE
  MUJER
  UNISEX
  NICHO
}

enum Presentation {
  CERRADO
  TESTER
  TESTER_SIN_CAJA
  COFRE
  COFRE_DEO
  EDICION_LIMITADA
  LANZAMIENTO
  OTRO
}

enum ImageType {
  PRODUCTO
  PACKAGING
  DETAIL
  LIFESTYLE
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id              String   @id @default(uuid())
  brand           String
  name            String
  normalizedName  String
  line            String?
  gender          Gender
  categoryId      String
  concentration   String?
  description     String?
  olfactoryNotes  String?
  active          Boolean  @default(true)

  // Trazabilidad del proveedor — sección 60 / 63
  supplierOriginalName   String?
  supplierReferencePrice Decimal? @db.Decimal(12, 2)
  supplierDiscount       Decimal? @db.Decimal(5, 2)
  supplierPrice          Decimal? @db.Decimal(12, 2)
  supplierReference      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  @@map("products")
}

model ProductVariant {
  id           String       @id @default(uuid())
  productId    String
  volumeMl     Int
  presentation Presentation
  price        Decimal      @db.Decimal(12, 2)
  stock        Int          @default(0)
  active       Boolean      @default(true)

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@map("product_variants")
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String
  url       String
  type      ImageType @default(PRODUCTO)
  isPrimary Boolean   @default(false)
  order     Int       @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ------------------------------------------------------------
// REVIEWS
// ------------------------------------------------------------

enum ReviewStatus {
  PENDIENTE
  PUBLICADA
  RECHAZADA
}

model Review {
  id            String       @id @default(uuid())
  productId     String
  userId        String
  orderId       String?
  rating        Int
  title         String
  comment       String
  wouldRecommend Boolean
  verifiedPurchase Boolean   @default(false)
  status        ReviewStatus @default(PENDIENTE)
  createdAt     DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  // Una review por usuario/order/product — sección 22
  @@unique([userId, productId, orderId])
  @@map("reviews")
}

// ------------------------------------------------------------
// PEDIDOS / STOCK / PAGOS
// ------------------------------------------------------------

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  MERCADO_PAGO
  TRANSFERENCIA
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Order {
  id           String        @id @default(uuid())
  publicNumber String        @unique // ej. AUR-1042
  userId       String
  status       OrderStatus   @default(PENDIENTE)
  paymentMethod PaymentMethod
  subtotal     Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  items             OrderItem[]
  payment           Payment?
  shipping          Shipping?
  stockReservations StockReservation[]
  statusHistory     OrderStatusHistory[]

  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model StockReservation {
  id        String   @id @default(uuid())
  variantId String
  orderId   String
  quantity  Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  externalId    String? // id de pago en Mercado Pago (a futuro)
  amount        Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Shipping {
  id       String  @id @default(uuid())
  orderId  String  @unique
  method   String // retiro | envio
  cost     Decimal @default(0) @db.Decimal(12, 2)
  address  String?
  city     String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipping")
}

model Discount {
  id          String   @id @default(uuid())
  code        String?  @unique
  type        String // FIRST_PURCHASE, MANUAL, etc.
  percentage  Decimal  @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("discounts")
}

// ------------------------------------------------------------
// AUDITORÍA
// ------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}
